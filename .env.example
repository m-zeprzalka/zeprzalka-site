# Zmienne środowiskowe — skopiuj do .env.local (lokalnie) albo ustaw w Vercelu.
# Żadna nie jest wymagana do zbudowania serwisu.

# Adres kanoniczny (domyślnie https://www.zeprzalka.com)
NEXT_PUBLIC_SITE_URL=

# Profil LinkedIn — trafia do stopki i danych strukturalnych (sameAs)
NEXT_PUBLIC_LINKEDIN_URL=

# Weryfikacja Google Search Console i Bing (sam token, bez <meta>)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Formularz kontaktowy — tylko środowisko Production. Bez kompletu formularz
# nie wysyła i prosi o kontakt mailowy (nie wywraca się).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Odbiorca wiadomości (domyślnie m@zeprzalka.com)
CONTACT_EMAIL=

# Piaskownica /demo na produkcji (domyślnie wyłączona)
DEMO_PUBLIC=
