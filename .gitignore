# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prywatne notatki i raporty (np. szczegóły bezpieczeństwa) — tylko lokalnie
/docs/prywatne/

# pnpm visual — mapy różnic
/.visual/

# Claude Code — ustawienia lokalne i worktree agentów
/.claude/

# Prywatne pliki właściciela w drzewie roboczym — nigdy do publicznego repozytorium
# (zdjęcie twarzy nie może trafić do public/, briefy i szkice są robocze).
/public/DSC_0031.jpg
/docs/prompt*.md
/content/drafts/budowa-saas.txt
